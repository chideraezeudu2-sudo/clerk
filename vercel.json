{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/scout", "schedule": "0 6 * * *" },
    { "path": "/api/scout", "schedule": "0 14 * * *" },
    { "path": "/api/scout", "schedule": "0 21 * * *" }
  ]
}
